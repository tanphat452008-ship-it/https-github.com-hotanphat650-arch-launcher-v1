<?xml version="1.0" encoding="utf-8" ?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
	<item android:id="@android:id/background">
		<shape>
			<solid android:color="#a32c2c2c" />
			<corners android:radius="@dimen/_100sdp" />
		</shape>
	</item>
	<item android:id="@android:id/progress">
		<scale android:scaleWidth="100%">
			<shape>
				<gradient android:startColor="#ff5a5a5a" android:endColor="#ff7c7c7c" android:angle="45.0" android:centerX="79.99999%" android:centerColor="#ffc6c6c6" />
				<stroke android:width="1.0dip" android:color="#79151515" />
				<corners android:radius="@dimen/_100sdp" />
			</shape>
		</scale>
	</item>
</layer-list>
