		</clip>
	</item>
	<item android:id="@android:id/progress">
		<clip>
			<shape>
				<gradient android:startColor="#fffab311" android:endColor="#ffbd6418" android:angle="270.0" android:centerColor="#ffd98815" />
				<corners android:radius="50.0dip" />
			</shape>
		</clip>
