<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:aapt="http://schemas.android.com/aapt">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#36000000"
                android:endColor="#56000000"
                android:angle="135"
                android:type="linear"
                android:centerX="0.45"/>
            <corners android:radius="0dp"/>
            <stroke
                android:width="1dp"
                android:color="#000077ff"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="0dp"/>
            <stroke
                android:width="1dp"
                android:color="#5effffff"/>
        </shape>
    </item>
</layer-list>